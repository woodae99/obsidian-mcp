# Obsidian MCP Server 环境变量示例
# 复制此文件为 .env 并填入您的实际配置

# Obsidian Vault 路径
OBSIDIAN_VAULT_PATH=./vault

# Obsidian API Token
# 请在 Obsidian 中生成您自己的 API Token
OBSIDIAN_API_TOKEN=your_api_token_here

# Obsidian API 端口
OBSIDIAN_API_PORT=27123

# Link-aware move route exposed by obsidian-link-extension
# Used by move_note and manage_folder rename/move to delegate to Obsidian Core
OBSIDIAN_LINK_PLUGIN_MOVE_ROUTE=/links/move-v3
